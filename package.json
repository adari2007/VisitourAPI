{
  "name": "visitour-api",
  "version": "1.0.0",
  "description": "Backend API for Visitour web and mobile clients",
  "private": true,
  "scripts": {
    "dev": "yarn workspace @visitour/api dev",
    "dev:api": "yarn workspace @visitour/api dev",
    "build": "yarn workspace @visitour/api build",
    "build:api": "yarn workspace @visitour/api build",
    "lint": "yarn workspace @visitour/api lint",
    "type-check": "yarn workspace @visitour/api type-check",
    "test": "echo 'No root tests configured. Run API tests from apps/api when available.'",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,jsx,json,css}\" \"packages/**/*.{ts,tsx,js,jsx,json,css}\""
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "packageManager": "yarn@4.14.1"
}
